# ============================================================================
# .env.example - Environment Template for Criminal DBMS
# Copy this file to .env and replace placeholders with your actual passwords.
# NEVER commit .env to source control.
# ============================================================================

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=generate_a_secure_random_key_here_at_least_32_bytes

# Database Configuration (Host & Port)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crime_db

# 1. Migration / Admin Credentials (for executing DDL, triggers, and test fixtures)
DB_ADMIN_USER=crimedb_admin
DB_ADMIN_PASSWORD=YOUR_CHOSEN_ADMIN_PASSWORD_HERE

# 2. Runtime Application Credentials (for normal Flask web app operations)
DB_APP_USER=crimedb_app
DB_APP_PASSWORD=YOUR_CHOSEN_APP_PASSWORD_HERE

# Public Data Ingestion Settings
CHICAGO_API_LIMIT=5000
CHICAGO_API_MAX=50000
